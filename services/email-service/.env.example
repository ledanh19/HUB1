# ─── Supabase ────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # service_role key – NEVER expose to client

# ─── Google OAuth ────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4100/email/gmail/callback

# ─── Token Encryption (AES-256-GCM) ─────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# ─── Server ──────────────────────────────────────────────────
PORT=4100
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# ─── JWT verification ───────────────────────────────────────
SUPABASE_JWT_SECRET=  # from Supabase dashboard > Settings > API > JWT Secret

# ─── Sync Worker (optional – sensible defaults) ─────────────
# SYNC_CRON=*/2 * * * *              # cron schedule
# SYNC_MAX_THREADS=50                 # max INBOX threads per cycle
# SYNC_INTER_ACCOUNT_DELAY_MS=500     # delay between accounts
# SYNC_MAX_CONSECUTIVE_ERRORS=3       # circuit breaker threshold
# SYNC_BACKOFF_BASE_MS=2000           # base for exponential backoff
# SYNC_LOCK_STALE_MIN=10              # lock auto-expire minutes
