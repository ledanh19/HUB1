[
  {
    "id": "TC001",
    "title": "Login with valid credentials and land on the dashboard",
    "description": "Verifies a user can log in with valid credentials and access the authenticated dashboard.",
    "category": "Authentication and User Management",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to /auth"
      },
      {
        "type": "assertion",
        "description": "Verify URL contains \"/auth\""
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_USER}}\" into the email field"
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_PASSWORD}}\" into the password field"
      },
      {
        "type": "action",
        "description": "Click the \"Login\" button"
      },
      {
        "type": "assertion",
        "description": "Verify URL contains \"/\""
      },
      {
        "type": "assertion",
        "description": "Verify page title contains \"Dashboard\""
      }
    ]
  },
  {
    "id": "TC002",
